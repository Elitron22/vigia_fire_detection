[Unit]
Description=TFM detector de humo y fuego (prueba NCNN 640)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__TFM_USER__
WorkingDirectory=__TFM_ROOT__
Environment=TFM_PROJECT_ROOT=__TFM_ROOT__
Environment=TFM_APP_CONFIG=__TFM_ROOT__/configs/app.rpi5.ncnn640.yaml
Environment=TFM_APP_MODEL_PATH=__TFM_ROOT__/model/yolo26s_640_ncnn_model
Environment=TFM_APP_MODEL_ID=yolo26s_640_ncnn_rpi5
Environment=TFM_APP_MODEL_KEY=yolo26s
Environment=TFM_APP_TRAINED_IMGSZ=768
Environment=TFM_APP_DEVICE=cpu
Environment=TFM_TELEGRAM_MODE=dry_run
EnvironmentFile=-__TFM_ROOT__/.env.telegram
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
ExecStart=__TFM_ROOT__/.venv-rpi5-ncnn/bin/python __TFM_ROOT__/tools/run_detection_app.py --host 127.0.0.1 --port 8003
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
